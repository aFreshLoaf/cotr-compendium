# Local development environment variables
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit it.

# From your Supabase project dashboard (Settings → API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Use your PUBLISHABLE key (sb_publishable_...). This is safe to ship in the
# client; access is gated by Row-Level Security. Do NOT put the secret key here.
VITE_SUPABASE_ANON_KEY=your-publishable-key-here
